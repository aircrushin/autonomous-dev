{
  "name": "autonomous-dev",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-quality-scripts.mjs",
    "lint": "node scripts/lint.mjs",
    "scan:secrets": "node scripts/scan-secrets.mjs",
    "ci:local": "node scripts/ci-local.mjs",
    "test": "tsx --test tests/**/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "devctl": "tsx apps/cli/src/index.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
